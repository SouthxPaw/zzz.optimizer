# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out
/temp

# Node modules and logs
/node_modules
npm-debug.log*
yarn-error.log*

# Angular / build caches
/.angular/cache
.sass-cache/
.connect.lock
/coverage
/typings
/libpeerconnection.log
testem.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Miscellaneous files to ignore
.claude
*.md
!README.md

# Scripts folder (contains sensitive UIDs and analysis data)
/scripts

# Local environment file (contains private Cloudflare Worker URL)
/src/environments/environment.local.ts

# Transient backup of the full agents.json, written while a build slims it.
# Only present if a build was interrupted; the next build restores from it.
/src/assets/data/agents.full.json

# Working directories for build-scripts/compress-wengine-videos.js.
# -compressed holds encode output pending review; -original holds the
# untouched source set after --apply swaps the compressed files in.
/src/assets/data/images/wengine-gifs-compressed/
/src/assets/data/images/wengine-gifs-original/

# System files
.DS_Store
Thumbs.db
nul

# Encode comparison samples (build-scripts/compress-wengine-videos.js)
/src/assets/data/images/wengine-samples/
